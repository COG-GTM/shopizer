<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd
                            http://www.ehcache.org/v3/jsr107 http://www.ehcache.org/schema/ehcache-107-ext-3.0.xsd">

    <service>
        <jsr107:defaults default-template="default"/>
    </service>

    <cache-template name="default">
        <expiry>
            <ttl unit="seconds">120</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache-template>

    <cache alias="com.shopizer.OBJECT_CACHE">
        <expiry>
            <ttl unit="seconds">1200</ttl>
        </expiry>
        <resources>
            <heap unit="entries">10000</heap>
        </resources>
    </cache>

    <!-- Ehcache 3 has no LRU/LFU eviction policy equivalent. -->
    <cache alias="store">
        <expiry><none/></expiry>
        <resources><heap unit="entries">1000</heap></resources>
    </cache>
    <cache alias="countriesMap">
        <expiry><none/></expiry>
        <resources><heap unit="entries">500</heap></resources>
    </cache>
    <cache alias="countrByCode">
        <expiry><none/></expiry>
        <resources><heap unit="entries">300</heap></resources>
    </cache>
    <cache alias="zoneByCode">
        <expiry><none/></expiry>
        <resources><heap unit="entries">800</heap></resources>
    </cache>
    <cache alias="languageByCode">
        <expiry><none/></expiry>
        <resources><heap unit="entries">50</heap></resources>
    </cache>

    <cache alias="com.salesmanager.core.model.reference.currency.Currency" uses-template="default"/>
    <cache alias="com.salesmanager.core.model.reference.country.Country" uses-template="default"/>
    <cache alias="com.salesmanager.core.model.reference.language.Language" uses-template="default"/>
    <cache alias="default-query-results-region" uses-template="default"/>
    <cache alias="default-update-timestamps-region" uses-template="default"/>
</config>