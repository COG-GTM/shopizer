<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.ehcache.org/v3"
	xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

	<cache-template name="default">
		<expiry>
			<tti unit="seconds">120</tti>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache-template>

	<cache alias="com.shopizer.OBJECT_CACHE" uses-template="default">
		<expiry>
			<ttl unit="seconds">1200</ttl>
		</expiry>
		<heap unit="entries">10000</heap>
	</cache>

	<cache alias="store" uses-template="default">
		<expiry>
			<none/>
		</expiry>
		<heap unit="entries">1000</heap>
	</cache>

	<cache alias="countriesMap" uses-template="default">
		<expiry>
			<none/>
		</expiry>
		<heap unit="entries">500</heap>
	</cache>

	<cache alias="countrByCode" uses-template="default">
		<expiry>
			<none/>
		</expiry>
		<heap unit="entries">300</heap>
	</cache>

	<cache alias="zoneByCode" uses-template="default">
		<expiry>
			<none/>
		</expiry>
		<heap unit="entries">800</heap>
	</cache>

	<cache alias="languageByCode" uses-template="default">
		<expiry>
			<none/>
		</expiry>
		<heap unit="entries">50</heap>
	</cache>

</config>
