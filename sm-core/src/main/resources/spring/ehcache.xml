<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core.xsd">
    <cache-template name="hibernate-default">
        <expiry><ttl unit="seconds">120</ttl></expiry>
        <heap unit="entries">10000</heap>
    </cache-template>
    <cache alias="com.salesmanager.core.model.reference.country.Country" uses-template="hibernate-default"/>
    <cache alias="com.salesmanager.core.model.reference.currency.Currency" uses-template="hibernate-default"/>
    <cache alias="com.salesmanager.core.model.reference.language.Language" uses-template="hibernate-default"/>
    <cache alias="default-query-results-region" uses-template="hibernate-default"/>
    <cache alias="default-update-timestamps-region" uses-template="hibernate-default"/>
    <cache alias="com.shopizer.OBJECT_CACHE">
        <expiry><ttl unit="seconds">1200</ttl></expiry>
        <heap unit="entries">10000</heap>
    </cache>
    <cache alias="store">
        <expiry><none/></expiry>
        <heap unit="entries">1000</heap>
    </cache>
    <cache alias="countriesMap">
        <expiry><none/></expiry>
        <heap unit="entries">500</heap>
    </cache>
    <cache alias="countrByCode">
        <expiry><none/></expiry>
        <heap unit="entries">300</heap>
    </cache>
    <cache alias="zoneByCode">
        <expiry><none/></expiry>
        <heap unit="entries">800</heap>
    </cache>
    <cache alias="languageByCode">
        <expiry><none/></expiry>
        <heap unit="entries">50</heap>
    </cache>
</config>