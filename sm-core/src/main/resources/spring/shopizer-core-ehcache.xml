<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
   http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="jCacheManager" class="org.springframework.cache.jcache.JCacheCacheManager">
		<property name="cacheManager">
			<bean class="org.springframework.cache.jcache.JCacheManagerFactoryBean">
				<property name="cacheManagerUri" value="classpath:/spring/ehcache-jcache.xml" />
			</bean>
		</property>
	</bean>

	<bean id="serviceCache" factory-bean="jCacheManager" factory-method="getCache">
		<constructor-arg value="com.shopizer.OBJECT_CACHE" />
	</bean>

</beans>
