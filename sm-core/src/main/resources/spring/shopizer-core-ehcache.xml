<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
   http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean id="jCacheManagerFactory" class="org.springframework.cache.jcache.JCacheManagerFactoryBean">
		<property name="cacheManagerUri" value="classpath:/spring/ehcache3.xml" />
	</bean>

	<bean id="serviceCacheManager" class="org.springframework.cache.jcache.JCacheCacheManager">
		<property name="cacheManager" ref="jCacheManagerFactory" />
	</bean>

</beans>
