	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!--java version -->
		<java.version>21</java.version>

		<maven.compiler.release>${java.version}</maven.compiler.release>

		<shopizer.search.version>2.11.1</shopizer.search.version>
		<shopizer-canadapost.version>2.15.0</shopizer-canadapost.version>

		<!-- TODO replace with starter -->
		<guava.version>33.7.2-jre</guava.version>
		<commons-lang.version>3.21.0</commons-lang.version>
		<commons-io.version>2.22.0</commons-io.version>
		<commons-collections4.version>4.6.0</commons-collections4.version>
		<commons-validator.version>1.11.0</commons-validator.version>
		<org.mapstruct.version>1.6.3</org.mapstruct.version>

		<!-- jakarta.*, jackson, httpclient5 and mysql-connector-j versions are managed by the Spring Boot BOM -->
		<infinispan.version>9.4.24.Final</infinispan.version>
		<!-- infinispan-tree (CMS default file store) has no release after 9.4.x, which needs Caffeine 2.x (CacheWriter); Boot 3 manages Caffeine 3.x -->
		<caffeine.version>2.9.3</caffeine.version>
		<infinispan.tree.version>9.4.24.Final</infinispan.tree.version>
		<oracle.version>18.3.0.0</oracle.version>
		<postgresql.version>42.2.18</postgresql.version>
		<simple-json-version>1.1.1</simple-json-version>
		<geoip2.version>2.7.0</geoip2.version>
		<drools.version>10.1.0</drools.version>
		<jsoup.version>1.21.2</jsoup.version>
		<google-client-maps-services-version>0.1.6</google-client-maps-services-version>
		<jwt.version>0.12.7</jwt.version>


		<!-- api documentation (springdoc 2.8.x targets Spring Boot 3.5) -->
		<springdoc.version>2.8.17</springdoc.version>
		<swagger-annotations.version>2.2.47</swagger-annotations.version>

		<!-- jacoco coverage -->
		<coverage.lines>.30</coverage.lines>
		<coverage.branches>.37</coverage.branches>

	</properties>

	<!--BOM -->
	<dependencyManagement>
