# Copy to .env and adjust. docker compose reads .env automatically.
# All values are optional; the defaults below are what docker-compose.yml uses.

# --- Ports published on the host ---
SHOPIZER_PORT=8080
SHOPIZER_DB_PORT=3307
SHOPIZER_ADMIN_PORT=4200
SHOPIZER_SHOP_PORT=3000

# --- MySQL (local development credentials only) ---
SHOPIZER_DB_USER=shopizer
SHOPIZER_DB_PASSWORD=shopizer
MYSQL_ROOT_PASSWORD=shopizer-root

# --- Backend ---
# JVM flags for the backend container
SHOPIZER_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
# Public base URL used to build links to images/static content
SHOPIZER_CONTENT_URL=http://localhost:8080
# Tag given to the locally built backend image
SHOPIZER_IMAGE=shopizer:local

# --- Build ---
# Optional Maven mirror / repository manager used during `docker compose build`
# MAVEN_MIRROR_URL=https://nexus.example.com/repository/maven-public/

# --- Image overrides (e.g. to use a registry mirror) ---
# MYSQL_IMAGE=mysql:8.0
# SHOPIZER_ADMIN_IMAGE=shopizerecomm/shopizer-admin:latest
# SHOPIZER_SHOP_IMAGE=shopizerecomm/shopizer-shop-reactjs:latest
